# ---------------------------------------------------------------- application
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated list of allowed origins, or * to reflect any origin (dev only)
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------- database
# Credentials belong in the URI; never log this value.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=secure_notes
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# Logs every query. Never enable outside local development.
MONGODB_DEBUG=false
# Build the indexes the schemas declare during boot. Unset follows NODE_ENV:
# on everywhere but production, where the deploy runs `pnpm db:indexes:prod`
# before the new code starts taking traffic.
MONGODB_SYNC_INDEXES=true

# ------------------------------------------------------------------- security
# Minimum 32 characters, and the two secrets must differ.
# Generate with: openssl rand -base64 36
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-32-character-secret
JWT_REFRESH_EXPIRES_IN=7d
# 10-15. Higher is slower and safer; 12 is a good default.
BCRYPT_SALT_ROUNDS=12
# Failed logins before the account locks, and how long it stays locked.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MS=900000

# ---------------------------------------------------------------- client keys
# Comma-separated keys accepted in the `x-api-key` header, one per client app.
# Leave empty to disable the gate locally; production refuses to boot without
# at least one. Generate with: openssl rand -hex 32
API_KEYS=

# ------------------------------------------------------------------ rate limit
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --------------------------------------------------------- first administrator
# Set both to create an admin account on first boot; leave both unset to skip.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Change-This-Admin-1!
